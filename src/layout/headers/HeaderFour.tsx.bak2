'use client'
import Link from "next/link";
import { useState, useEffect } from "react";

const PRODUCT_LINKS = [
  { href: "/features/scheduling", label: "Scheduling", desc: "Access windows & time zones" },
  { href: "/features/recording", label: "Recording", desc: "Tamper-proof, local + cloud" },
  { href: "/features/monitoring", label: "Live Monitoring", desc: "Watch sessions from browser" },
  { href: "/features/ai", label: "Eazy AI", desc: "Ratings & off-topic alerts" },
  { href: "/features/courses", label: "Course Management", desc: "Curriculum with annotation" },
  { href: "/features/marketing", label: "Social Publishing", desc: "YouTube & 6 platforms" },
];

const HeaderFour = () => {
